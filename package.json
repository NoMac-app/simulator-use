{
  "name": "simulator-use",
  "version": "0.14.0",
  "description": "Simulator use for agents: read and drive the iOS Simulator from any MCP client or the command line.",
  "mcpName": "app.nomac/simulator-use",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoMac-app/simulator-use.git"
  },
  "homepage": "https://simulator-use.dev",
  "bugs": {
    "url": "https://github.com/NoMac-app/simulator-use/issues"
  },
  "type": "module",
  "bin": {
    "simulator-use": "bin/simulator-use.js",
    "simtap": "bin/simulator-use.js"
  },
  "exports": {
    "./tools.json": "./dist/tools.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "skill",
    "vendor/axe",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/tools-json.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "axe": "node scripts/fetch-axe.mjs",
    "prepack": "node scripts/fetch-axe.mjs && node scripts/build-native.mjs && npm run build",
    "native": "node scripts/build-native.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "ios",
    "simulator",
    "agent",
    "testing",
    "accessibility",
    "simulator-use",
    "ios-simulator",
    "agents",
    "simtap"
  ]
}
